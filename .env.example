# Copy to .env on the server, chmod 600, then fill in real values.
BRIDGE_TOKEN=replace-with-openssl-rand-hex-32
TZ=Asia/Shanghai

BACKFILL_DAYS=365
RATE_LIMIT_PER_MIN=60
SYNC_RATE_LIMIT_PER_MIN=6

# Host header values the MCP transport accepts. Set to your public host.
# Example: health.example.com,health.example.com:443
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*

# Host ports on 127.0.0.1 (container always listens on 8787/8788).
REST_PORT=8787
MCP_PORT=8789

# Optional: encrypt backups created by deploy/backup.sh
# BACKUP_PASSPHRASE=change-me
